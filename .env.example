# LLM Provider Routing:
# - "auto" (default): Uses local Ollama automatically when running on localhost:11434 (or when GEMINI_API_KEY is unset),
#   and uses server-side Gemini in cloud preview environments.
# - "ollama": Force local Ollama
# - "gemini": Force Google Gemini API
LLM_PROVIDER="auto"

# Local Ollama Configuration (Default on local clone)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Qdrant Vector Database Configuration (Default on local clone)
# Leave QDRANT_API_KEY blank / empty ("") for a local Qdrant instance without API key authentication.
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="lexgate_policies"
QDRANT_API_KEY=""

# Redis Epoch-Keyed Semantic Cache (Default on local clone; falls back to in-memory Map in cloud preview)
REDIS_URL="redis://localhost:6379"
REDIS_TTL_SECONDS="3600"

# GEMINI_API_KEY: Optional in local Ollama mode; automatically injected in AI Studio cloud preview.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL (injected automatically in Cloud Run / AI Studio)
APP_URL="MY_APP_URL"
